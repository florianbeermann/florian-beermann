# ===========================================================================
# PRE-LAUNCH GATE — delete this whole block to publish the site.
#
# The site is not public yet, so the server refuses to hand over a single byte
# of it without a valid access cookie. This has to happen here rather than in
# the app: a React login screen cannot protect a static site, because the
# bundle, the copy and the images are all still sitting there for anyone who
# opens the network tab, and the password would be in the JavaScript.
#
# Authorisation is expressed with `Require`, not with a `mod_rewrite` rule, and
# that is the load-bearing decision in this block. The obvious way to gate on a
# cookie is to rewrite unauthenticated requests to the login page — but a
# rewrite that fails to match lets the request through, so any mistake in the
# pattern serves the site to everyone. `Require` inverts that: access is denied
# unless something grants it, so the same mistake locks everyone out instead.
# A gate is allowed to break. It is not allowed to break open.
#
# `__ACCESS_TOKEN__` is substituted by .github/workflows/deploy.yml, which
# derives it from the SITE_PASSWORD secret. It is a placeholder rather than a
# literal because this repository is public. Rotating the password changes the
# token, which signs everyone out — which is what rotating a password should do.
SetEnvIf Cookie "(^|;[[:space:]]*)fb_access=__ACCESS_TOKEN__([[:space:]]*;|$)" FB_ACCESS
Require env FB_ACCESS

# The login page and the handful of assets it is built from have to be readable
# without the cookie, or the page a visitor is sent to in order to obtain the
# cookie cannot render. Nothing here discloses anything: open-licensed fonts,
# the favicons, and a page whose entire content is the sentence "this is
# private".
#
# logo-wordmark.svg used to be on this list and is not any more. The login page
# drew its lockup from that file; it now inlines the mark and sets the name in
# Nippo, so the file is only reached from pages that are already behind the
# gate. An exemption nothing needs is a file served to anyone who asks for it.
<FilesMatch "^(login\.php|favicon\.(ico|svg|png)|apple-touch-icon\.png)$">
  Require all granted
</FilesMatch>

<FilesMatch "\.woff2$">
  Require all granted
</FilesMatch>

# The deploy and the hourly drift check read this to tell "we uploaded" from
# "the site actually changed". It carries a commit SHA of a public repository
# and a timestamp, so it stays readable rather than handing the site password
# to two workflows that have no other reason to hold it. Keeping it open is
# also what stops the gate from silently disabling the monitoring.
<Files "version.json">
  Require all granted
</Files>

# The password hash and the access token live here. PHP is never served as
# source, so this is belt and braces — but the file is one typo in a handler
# mapping away from being a plain-text download, and it is the one file on the
# server that would hand over the gate outright.
<Files "gate-secrets.php">
  Require all denied
</Files>

# Insurance against a password file left behind by the Basic Auth gate this
# replaced. The build no longer produces one, so the FTP sync should have
# removed it; Apache also denies `.ht*` by default. Neither is a reason to stop
# saying so here.
<Files ".htpasswd">
  Require all denied
</Files>

# The FTP action keeps its state file next to the site, and that file is a
# complete manifest of the deployed tree. Harmless behind the gate; an
# invitation once the gate comes down, so it is denied on its own terms.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Every refused request lands on the login page rather than on Apache's grey
# default. A local path, not an absolute URL: a full URL makes Apache issue a
# redirect instead of serving the document, which loses the original path and
# with it the ability to return the visitor where they were going.
ErrorDocument 403 /login.php
# ===========================================================================

RewriteEngine On
RewriteBase /

# Force HTTPS redirect
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fallback to index.html for client-side routing
RewriteRule ^index\.html$ - [L]

# Missing static assets must 404 rather than fall through to the SPA shell.
# Without this a deleted font or a typo'd image path returns 200 with an HTML
# body, which hides broken assets from monitoring and confuses the browser.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} \.(?:js|mjs|css|map|woff2?|ttf|otf|eot|webp|avif|jpe?g|png|gif|svg|ico|json|xml|txt|pdf|mp4|webm)$ [NC]
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Vite emits content-hashed filenames under /assets, so they can never go stale.
  SetEnvIf Request_URI "^/assets/" IMMUTABLE_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  # Fonts and images keep stable filenames, so cache them long but revalidatable.
  SetEnvIf Request_URI "\.(woff2|webp|jpg|jpeg|png|svg|ico)$" STATIC_ASSET
  Header set Cache-Control "public, max-age=2592000" env=STATIC_ASSET

  # The HTML shell must always be revalidated so new deploys are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType image/webp .webp
