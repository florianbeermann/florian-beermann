RewriteEngine On
RewriteBase /

# Force HTTPS redirect
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fallback to index.html for client-side routing
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Vite emits content-hashed filenames under /assets, so they can never go stale.
  SetEnvIf Request_URI "^/assets/" IMMUTABLE_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET

  # Fonts and images keep stable filenames, so cache them long but revalidatable.
  SetEnvIf Request_URI "\.(woff2|webp|jpg|jpeg|png|svg|ico)$" STATIC_ASSET
  Header set Cache-Control "public, max-age=2592000" env=STATIC_ASSET

  # The HTML shell must always be revalidated so new deploys are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType image/webp .webp
